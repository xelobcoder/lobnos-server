generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activation {
  ID        Int      @id @default(autoincrement())
  STATUS    String   @default("INACTIVE") @db.VarChar(100)
  PATIENTID Int
  DATE      DateTime @default(now()) @db.Date
}

model billing {
  BILLINGID    Int      @id @default(autoincrement())
  PATIENTID    BigInt
  PAID_AMOUNT  Int
  PAYABLE      Int
  DISCOUNT     Int
  CREATED_ON   DateTime @default(now()) @db.DateTime(6)
  UPDATED      DateTime @db.Date
  ORGANIZATION String   @db.VarChar(255)
  CLINICIAN    String   @db.VarChar(255)
  PAYMENT_MODE String   @db.VarChar(255)
  TYPE         String   @default("PREPAID") @db.VarChar(255)
  OUTSTANDING  Int
}

model bloodgroup {
  ID         Int       @id @default(autoincrement())
  BILLINGID  Int
  BLOODGROUP String    @db.VarChar(30)
  RHESUS     String    @db.VarChar(30)
  CREATED_ON DateTime? @default(now()) @db.Date
  UPDATED_ON DateTime? @default(now()) @db.Date
  TIME       DateTime? @db.Time(6)
  PATIENTID  Int
}

model branch {
  BRANCHID Int      @id @default(autoincrement())
  NAME     String   @db.VarChar(255)
  DATE     DateTime @default(now()) @db.Date
}

model branches {
  BRANCHID   Int      @id @default(autoincrement())
  BRANCHNAME String   @db.VarChar(255)
  DATE       DateTime @default(now()) @db.Date
  TIME       DateTime @default(now()) @db.Time(6)
}

model clinician {
  ID                    Int      @id @default(autoincrement())
  NAME                  String   @db.VarChar(255)
  WEBSITE               String   @db.VarChar(100)
  EMAIL                 String   @db.VarChar(100)
  CONTACT               Int
  LOCATION              String   @db.VarChar(100)
  ADDRESS               String   @db.VarChar(255)
  OCCUPATION            String   @db.VarChar(100)
  PAYMENT_MODULE        String   @map("PAYMENT MODULE") @db.VarChar(100)
  MOMO_NAME             String?  @map("MOMO NAME") @db.VarChar(100)
  MOMO_NUMBER           Int?     @map("MOMO NUMBER")
  BANK_NAME             String?  @map("BANK NAME") @db.VarChar(255)
  BANK_BRANCH           String?  @map("BANK BRANCH") @db.VarChar(255)
  ACCOUNT_NUMBER        Int?     @map("ACCOUNT NUMBER")
  ACCOUNT_NAME          String?  @map("ACCOUNT NAME") @db.VarChar(255)
  ORGANIZATION          String?  @db.VarChar(255)
  ORGANIZATION_POSITION Int?     @map("ORGANIZATION POSITION")
  DATE                  DateTime @default(now()) @db.Date
  UPDATE_ON             DateTime @default(now()) @db.Date
}

model commodity {
  COMID      Int      @id @default(autoincrement())
  COMMODITY  String   @db.VarChar(255)
  date       DateTime @default(now()) @db.DateTime(6)
  CATEGORY   String   @db.VarChar(255)
  suppliedby String?  @db.VarChar(255)
}

model companyprofile {
  ID          Int    @id @default(autoincrement())
  NAME        String @db.VarChar(100)
  EMAIL       String @db.VarChar(100)
  MOTTO       String @db.VarChar(255)
  PHONENUMBER Int
  ADDRESS     String @db.VarChar(255)
}

model hepatitisb {
  ID         Int       @id @default(autoincrement())
  BILLINGID  Int
  PATIENTID  BigInt
  CREATED_ON DateTime? @db.Date
  UPDATED_ON DateTime? @db.DateTime(6)
  TIME       DateTime? @db.Time(6)
}

model hepatitisb_profile {
  ID         Int       @id @default(autoincrement())
  HBsAg      String    @default("non reactive") @db.VarChar(50)
  HBsAb      String    @default("non reactive") @db.VarChar(50)
  HBeAg      String    @default("non reactive") @db.VarChar(50)
  HBeAb      String    @default("non reactive") @db.VarChar(50)
  HBcAb      String    @default("non reactive") @db.VarChar(50)
  Comments   String    @db.VarChar(255)
  BILLINGID  Int
  CREATED_ON DateTime? @default(now()) @db.Date
  UPDATED_ON DateTime? @default(now()) @db.Date
  SCIENTIST  String    @db.VarChar(100)
}

model malaria_test {
  TESTID    Int    @id @default(autoincrement())
  PATIENTID BigInt
  BILLINGID Int
  RESULT    String @db.VarChar(255)
  COMMENT   String @db.VarChar(255)
}

model manager_sample_descision {
  SAMPLEID  Int      @id @default(autoincrement())
  BILLINGID Int
  ACTION    String   @db.VarChar(255)
  MESSAGE   String   @db.VarChar(255)
  MANAGER   String   @db.VarChar(255)
  DATE      DateTime @default(now()) @db.DateTime(6)
}

model new_patients {
  ID                      Int       @id @default(autoincrement())
  PATIENTID               BigInt
  FULLNAME                String    @db.VarChar(100)
  EMAIL                   String?   @db.VarChar(100)
  DOB                     DateTime? @db.Date
  AGE                     Int
  GENDER                  String    @default("FEMALE") @db.VarChar(10)
  ORGANIZATION            String?   @db.VarChar(100)
  CLINICIAN               String?   @db.VarChar(100)
  PATIENTTYPE             String    @default("MAIN") @db.VarChar(100)
  LOCATION                String?   @db.VarChar(100)
  MARITAL_STATUS          String    @db.VarChar(50)
  EMMERGENCY_CONTACT      String    @db.VarChar(255)
  EMMERGENCY_CONTACT_NAME String    @db.VarChar(255)
  RELATIONSHIP            String    @db.VarChar(50)
  MOBILE_NUMBER           Int
  AGETYPE                 String    @db.VarChar(10)
  PATIENTORGANIZATION     String    @db.VarChar(255)
  OCCUPATION              String    @db.VarChar(255)
  DATE                    DateTime  @default(now()) @db.Date
  ACTIVATION_STATUS       String    @default("FALSE") @db.VarChar(10)
}

model newstock {
  stockid         Int      @id @default(autoincrement())
  name            String   @db.VarChar(255)
  category        String   @db.VarChar(255)
  consumptionunit String   @db.VarChar(255)
  purchaseunit    String   @db.VarChar(255)
  quantity        String   @db.VarChar(255)
  alertlevel      Int
  materialcode    String   @db.VarChar(255)
  tax             Int
  date            DateTime @default(now()) @db.DateTime(6)
}

model orders {
  productordersid  Int       @id @default(autoincrement())
  stockid          Int
  name             String    @db.VarChar(255)
  tax              Int
  supplierid       Int
  suppliername     String    @db.VarChar(255)
  purchaseunit     String    @db.VarChar(255)
  date             DateTime  @default(now()) @db.DateTime(6)
  quantity         Int
  received         String?   @default("FALSE") @db.VarChar(255)
  quantityReceived Int?
  Batchnumber      String?   @db.VarChar(255)
  balance          Int?      @default(0)
  expirydate       DateTime? @db.Date
  receiveddate     DateTime? @db.Date
  status           String?   @db.VarChar(255)
  price            Int?
  totalamount      Int?
  productused      String?   @default("FALSE") @db.VarChar(50)
}

model organization {
  ID             Int      @id @default(autoincrement())
  NAME           String   @db.VarChar(255)
  ADDRESS        String   @db.VarChar(255)
  WEBSITE        String   @db.VarChar(80)
  CONTACT        Int
  EMAIL          String   @db.VarChar(100)
  CONTACT_PERSON String   @db.VarChar(100)
  CTX_NUMBER     Int
  CTX_EMAIL      String   @db.VarChar(100)
  PAYMENT_MODULE String   @db.VarChar(500)
  BANK_NAME      String?  @map("BANK NAME") @db.VarChar(100)
  ACCOUNT_NUMBER Int?     @map("ACCOUNT NUMBER")
  ACCOUNT_BRANCH String?  @db.VarChar(100)
  BRANCH_NAME    String?  @map("BRANCH NAME") @db.VarChar(100)
  MOMO_NUMBER    Int?     @map("MOMO NUMBER")
  MOMO_NAME      String?  @map("MOMO NAME") @db.VarChar(100)
  UPDATE_ON      DateTime @default(now()) @db.Date
  DATE           DateTime @default(now()) @db.Date
}

model performing_test {
  ID                         Int       @id @default(autoincrement())
  PATIENTID                  String    @db.VarChar(255)
  TEST                       String    @db.VarChar(255)
  DATE                       DateTime  @default(now()) @db.Date
  URGENCY                    String    @db.VarChar(255)
  BILLINGID                  Int
  SAMPLING_CENTER            String    @db.VarChar(100)
  SAMPLE_STATUS              String?   @default("PENDING") @db.VarChar(100)
  INSPECTOR                  String?   @db.VarChar(255)
  INSPECTION_TIME            DateTime? @db.DateTime(6)
  PHELOBOTOMY_STATUS         String?   @default("QUEUE") @db.VarChar(100)
  SAMPLE_TAKEN_BY            String?   @db.VarChar(100)
  TIME_PHELOBOTOMY_COMPLETED DateTime? @db.Date
  ALL_SAMPLE_TAKEN           String?   @default("FALSE") @db.VarChar(50)
  MESSAGE                    String?   @db.Text
  TIME                       DateTime  @default(now()) @db.Time(6)
  PHELOBOTOMY_MESSAGE        String    @db.VarChar(255)
}

model roles {
  ROLEID       Int      @id @default(autoincrement())
  FULLNAME     String   @db.VarChar(100)
  USERNAME     String   @db.VarChar(255)
  ROLE         String   @db.VarChar(255)
  PASSWORD     String   @db.VarChar(255)
  DATE_CREATED DateTime @default(now()) @db.Date
  TIME         DateTime @default(now()) @db.Time(6)
}

model sample {
  ID             Int      @id @default(autoincrement())
  PATIENTID      Int
  DATE           DateTime @default(now()) @db.DateTime(6)
  APPROVALSTATUS String   @db.VarChar(100)
  MESSAGE        String   @db.VarChar(255)
  INSPECTOR      String   @db.VarChar(100)
  BILLINGID      BigInt
}

model setup_cardiac_enzymes {
  SETUPID   Int    @id @default(autoincrement())
  UNIT      String @db.VarChar(255)
  UPPER     Int
  LOWER     Int
  PARAMETER String @db.VarChar(255)
}

model setup_full_blood_count_test_general {
  FBCID     Int      @id @default(autoincrement())
  PARAMETER String   @db.VarChar(255)
  UNIT      String   @db.VarChar(10)
  LOWER     Int
  UPPER     Int
  DATE      DateTime @default(now()) @db.DateTime(6)
}

model setup_full_blood_count_test_male {
  FBCID     Int      @id @default(autoincrement())
  PARAMETER String   @db.VarChar(255)
  UNIT      String   @db.VarChar(10)
  LOWER     Int
  UPPER     Int
  DATE      DateTime @default(now()) @db.DateTime(0)
}

model setup_full_count_count_female {
  PARAMETER String   @db.VarChar(255)
  UNIT      String   @db.VarChar(10)
  UPPER     Int
  LOWER     Int
  DATE      DateTime @default(now()) @db.DateTime(6)
  FBCID     Int      @id @default(autoincrement())
}

model setup_glycated_heamoglobin_test {
  TESTID Int @id @default(autoincrement())
}

model setup_lipid_profile_test {
  SETUPID   Int    @id @default(autoincrement())
  PARAMETER String @db.VarChar(100)
  UPPER     Int
  LOWER     Int
  UNIT      String @db.VarChar(255)
}

model setup_liver_function_test {
  SETUPID   Int      @id @default(autoincrement())
  PARAMETER String   @db.VarChar(100)
  UPPER     Int
  LOWER     Int
  DATE      DateTime @default(now()) @db.DateTime(6)
  UNIT      String   @db.VarChar(10)
}

model setup_renal_function_test {
  SETUPID   Int    @id @default(autoincrement())
  PARAMETER String @db.VarChar(100)
  UPPER     Int
  LOWER     Int
  UNIT      String @db.VarChar(20)
}

model setup_thyroid_test {
  SETUPID   Int    @id @default(autoincrement())
  PARAMETER String @db.VarChar(255)
  UNIT      String @db.VarChar(255)
  UPPER     Int
  LOWER     Int
}

model supplier {
  SUPPLIERID    Int      @id @default(autoincrement())
  NAME          String   @db.VarChar(255)
  COMMODITY     String   @db.VarChar(255)
  ADDRESS       String   @db.VarChar(255)
  DATE          DateTime @default(now()) @db.DateTime(6)
  PHONENUMBER   Int
  CONTACTPERSON String   @db.VarChar(255)
  REGION        String   @db.VarChar(255)
  EMAIL         String   @db.VarChar(255)
}

model test_categories {
  ID          Int    @id @default(autoincrement())
  CATEGORY    String @db.VarChar(255)
  DESCRIPTION String @db.VarChar(255)
}

model test_panels {
  ID         Int      @id @default(autoincrement())
  NAME       String   @db.VarChar(255)
  CATEGORY   String   @db.VarChar(255)
  PRICE      Int
  CREATED_ON DateTime @default(now()) @db.DateTime(0)
}

model typhoid_test {
  TESTID       Int      @id @default(autoincrement())
  PATIENTID    BigInt
  BILLINGID    Int
  RESULT       String   @db.VarChar(255)
  COMMENTS     String   @db.VarChar(255)
  TYPHI_O      Float?   @db.Float
  TYPHI_H      Float?   @db.Float
  PARATYPHI_BH Float?   @db.Float
  PARATYPHI_AH Float?   @db.Float
  DATE         DateTime @default(now()) @db.Date
  TIME         DateTime @default(now()) @db.Time(6)
  ENTERED_BY   String   @db.VarChar(100)
}

model departments {
  id                Int      @id @default(autoincrement())
  department        String   @db.VarChar(100)
  departmentManager String   @db.VarChar(100)
  date              DateTime @default(now()) @db.DateTime(6)
  employeeid        Int
}

model departmentrequisitionhx {
  id                 Int      @id @default(autoincrement())
  departmentid       Int
  stockid            Int
  quantity_requested Int
  quantity_approved  Int?
  comsumptionunit    String   @db.VarChar(255)
  status             String?  @default("pending") @db.VarChar(20)
  date               DateTime @default(now()) @db.Date
  requisitionid      String   @db.VarChar(255)
  issue_message      String?  @db.Text
  departmentReceived Int?     @default(0)
  store_supplied     Int?     @default(0)
  quantityReceived   Int?     @default(0)
}

model departmentstocks {
  id                Int       @id @default(autoincrement())
  deptid            Int
  stockid           Int
  quantityAvailable Int
  date_added        DateTime  @default(now()) @db.Date
  dateupdated       DateTime? @db.Date
  comsupmtionunit   String    @db.VarChar(210)
}

model stockcategory {
  id       Int      @id @default(autoincrement())
  category String   @db.VarChar(255)
  date     DateTime @db.DateTime(6)
}
