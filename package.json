{
  "name": "lobnos-server",
  "version": "1.0.0",
  "description": "Server for running lobnos sotware",
  "main": "app.js",
  "bin": "./dist/src/start.js",
  "pkg": {
    "scripts": [
      "./dist/src/start.js"
    ],
    "assets": [
      ".env"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "scripts": {
    "dev": "node --watch --env-file=./.env ./dist/src/app.js",
    "build": "tsc",
    "tsdev": "npx tsc --w",
    "start": "npm run kill-port && node --env-file=./.env ./dist/src/app.js",
    "kill-port": "node  --env-file=./.env ./dist/src/models/security/killport.js  ",
    "backup-scheduler:start": "node --env-file=./.env ./scripts/backup-scheduler.js start",
    "backup-scheduler:stop": "node --env-file=./.env ./scripts/backup-scheduler.js stop",
    "backup-scheduler:status": "node --env-file=./.env ./scripts/backup-scheduler.js status"
  },
  "keywords": [
    "high performance laboratory information system",
    "lims"
  ],
  "author": "Tiifu Hamza",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "kysely": "^0.27.4",
    "luxon": "^3.6.1",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "node-cron": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.10.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}