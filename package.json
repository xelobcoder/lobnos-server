{
  "name": "PrimeLabSystem(PLS)",
  "version": "0.0.1",
  "description": "High Performance Laboratory Information System",
  "main": "app.js",
  "bin": "./dist/src/start.js",
  "pkg": {
    "scripts": [
      "./dist/src/start.js"
    ],
    "assets": [
      ".env"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "scripts": {
    "dev": "node --watch --env-file=./.env ./dist/src/app.js",
    "nsstart": "node --env-file=.env ./dist/src/app.js",
    "build": "tsc",
    "test": "vitest run",
    "test:licensing:desktop-build": "node --test ./scripts/licensing/build-desktop.test.cjs",
    "test:email": "ts-node ./src/models/application/email/tests/run-email-tests.ts && node --require ts-node/register --test \"src/models/application/email/tests/*.test.ts\"",
    "tsdev": "npx tsc --w",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { if ($IsWindows) { $svc = Get-Service -Name 'PrimeLabSystemRuntime' -ErrorAction SilentlyContinue; if ($null -ne $svc) { & powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action restart } else { & powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/windows/install-service.ps1 -StartNow } } else { npm run kill-port; node --env-file=./.env ./dist/src/start.js } }\"",
    "kill-port": "node --env-file=./.env ./dist/src/models/security/killport.js",
    "kill-port:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/kill-port.ps1",
    "service:prereq:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/install-nssm.ps1",
    "service:install:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/install-service.ps1 -StartNow",
    "service:uninstall:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/uninstall-service.ps1",
    "service:uninstall:lobnos": "powershell -ExecutionPolicy Bypass -Command \"& { & powershell -ExecutionPolicy Bypass -File ./scripts/windows/uninstall-service.ps1 -ServiceName 'LobnosServer'; & powershell -ExecutionPolicy Bypass -File ./scripts/windows/uninstall-service.ps1 -ServiceName 'LobnosLauncher' }\"",
    "service:start:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action start",
    "service:stop:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action stop",
    "service:restart:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action restart",
    "service:status:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action status",
    "service:backup:install:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/install-backup-scheduler-service.ps1 -StartNow",
    "service:backup:uninstall:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/uninstall-service.ps1 -ServiceName bkspls",
    "service:backup:start:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action start -ServiceName bkspls",
    "service:backup:stop:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action stop -ServiceName bkspls",
    "service:backup:restart:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action restart -ServiceName bkspls",
    "service:backup:status:win": "powershell -ExecutionPolicy Bypass -File ./scripts/windows/service-control.ps1 -Action status -ServiceName bkspls",
    "backup-scheduler:start": "node --env-file=./.env ./dist/src/scripts/backup-scheduler.js start",
    "email:worker": "node --env-file=./.env ./dist/src/models/application/email/workers/emailQueueWorker.js",
    "email:worker:dev": "node --env-file=./.env ./node_modules/ts-node/dist/bin.js --files ./src/models/application/email/workers/emailQueueWorker.ts",
    "notification:test": "node --env-file=./.env ./scripts/test-notification.js",
    "email:send:gmail": "node --env-file=./.env ./scripts/send-gmail-email.js",
    "setup:new-client": "node --env-file=./.env ./node_modules/ts-node/dist/bin.js ./scripts/setup-new-client.ts",
    "onboard:client": "node --env-file=./.env ./node_modules/ts-node/dist/bin.js ./scripts/onboard-client.ts",
    "export:db": "node --env-file=./.env ./node_modules/ts-node/dist/bin.js ./scripts/export-database.ts",
    "master:merge": "node --env-file=./.env ./scripts/merge-master-databases.js",
    "tenants": "node --env-file=./.env ./node_modules/ts-node/dist/bin.js ./scripts/tenants.ts",
    "nginx:new-client": "node ./node_modules/ts-node/dist/bin.js ./scripts/generate-nginx-config.ts",
    "create-distribution": "node ./scripts/create-distribution.js",
    "create-distribution:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/create-distribution.bat",
    "create-distribution:linux": "bash ./scripts/create-distribution.sh",
    "verify-distribution": "node ./distribution/verify-distribution.js",
    "desktop:build:licensed": "node ./scripts/licensing/build-desktop.cjs",
    "desktop:configure-install-password": "node ./scripts/licensing/installation-verifier.cjs"
  },
  "keywords": [
    "high performance laboratory information system",
    "lims"
  ],
  "author": "Tiifu Hamza",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "bullmq": "^6.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "install": "^0.13.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "kysely": "^0.27.4",
    "luxon": "^3.6.1",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.5",
    "node-cron": "^4.2.0",
    "nodemailer": "^9.0.4",
    "reflect-metadata": "^0.2.2",
    "uuid": "^14.0.1",
    "winston": "^3.10.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.1",
    "@types/uuid": "^10.0.0",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}