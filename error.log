{"code":"ER_WRONG_FIELD_WITH_GROUP","errno":1055,"level":"error","message":"Database query error: Expression #1 of SELECT list is not in GROUP BY clause and contains nonaggregated column 'primelab.np.firstname' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by","sql":"\n  SELECT \n    CONCAT(np.firstname, ' ', np.middlename, ' ', np.lastname) AS fullname,\n    CONCAT(np.age, \" \", np.agetype) AS age,\n            np.patientid,\n            b.billingid,\n            tp.category,\n            ta.processingStartDate,\n            np.fullpatientid,\n            ta.processingEndDate,\n            ta.resultEntryStart,\n            ta.resultEntryEnd,\n            ds.paymentstatus,\n            b.billedon AS billing_date,\n            d.department,\n            ta.id AS ascensionid,\n            ta.ascension_date,\n            tp.name,\n            ds.clinicianId,\n            ss.approvalstatus,\n            dta.printCount,\n            tp.id,\n            b.clientstatus,\n            org.name AS organization,\n            clin.name AS clinicianName\n  FROM dboServices AS ds\n  INNER JOIN billing AS b ON b.billingid = ds.billingid \n  INNER JOIN test_ascension AS ta ON ta.serviceid = ds.serviceid\n  INNER JOIN samplestatus AS ss ON ss.ascensionid = ta.id\n  INNER JOIN test_panels AS tp ON tp.id = ss.testid\n  LEFT JOIN departments AS d ON d.id = tp.category\n  LEFT JOIN organization AS org ON org.id = ds.organizationId\n  LEFT JOIN clinicianbasicinfo AS clin ON clin.id = ds.clinicianId\n  INNER JOIN new_patients AS np  ON np.patientid = b.patientid\n  INNER JOIN dbotestresultapproval AS dta ON dta.ascensionid = ta.id\n  WHERE ss.approvalstatus = 1\n      AND (ta.collectionStartDate IS NOT NULL AND ta.collectionEndDate IS NOT NULL) AND (ds.isDeleted = 0 OR ds.isDeleted IS NULL)\nAND (ta.processingStartDate IS NOT NULL AND ta.processingEndDATE IS NOT NULL) AND ta.resultEntryStart IS NOT NULL AND ta.resultEntryEnd IS NOT NULL AND  dta.isapproved = 0\nAND (d.department <> 'ultrasound' OR d.department IS NULL)\n       AND ta.id = '6' GROUP BY b.billingid,ta.testid ORDER BY b.billingid DESC LIMIT 10 OFFSET 0 ","sqlMessage":"Expression #1 of SELECT list is not in GROUP BY clause and contains nonaggregated column 'primelab.np.firstname' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by","sqlState":"42000","stack":"Error: Expression #1 of SELECT list is not in GROUP BY clause and contains nonaggregated column 'primelab.np.firstname' which is not functionally dependent on columns in GROUP BY clause; this is incompatible with sql_mode=only_full_group_by\n    at PromisePoolConnection.query (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\node_modules\\mysql2\\lib\\promise\\connection.js:29:22)\n    at promisifyQuery (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\hooks\\helper.js:87:43)\n    at process.processTicksAndRejections (node:internal/process/task_queues:105:5)\n    at async paginationQuery (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\hooks\\helper.js:129:12)\n    at async Operations.getAscensionBasedOnStage (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\models\\operations\\operations.js:492:24)\n    at async ascensionStagingHandler (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\controllers\\operations\\ascensionStageHandler.js:31:20)\n    at async C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\hooks\\helper.js:186:13"}
