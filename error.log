{"code":"ER_BAD_FIELD_ERROR","errno":1054,"level":"error","message":"Database query error: Unknown column 'chps.status' in 'where clause'","sql":"\n    SELECT\n        DATE(s.serviceAddedOn) AS service_date,\n        c.id AS clinician_id,\n        c.name AS clinician_name,\n        s.serviceid,\n        c.phone AS clinician_phone,\n        c.occupation,\n        c.organization,\n        COUNT(*) AS total_services,\n        SUM(s.totalpayable) AS total_payable,\n        SUM(s.paidamount) AS total_paid,\n        COALESCE(cp.commission, 0) AS commission_percent,\n        ROUND(SUM(s.totalpayable) * (COALESCE(cp.commission, 0) / 100), 2) AS commission_earned_by_amount_payable,\n        ROUND(SUM(s.paidamount) * (COALESCE(cp.commission, 0) / 100), 2) AS commission_earned_by_paid_amount\n    FROM dboservices s\n    INNER JOIN clinicianbasicinfo c\n        ON s.clinicianId = c.id\n    LEFT JOIN clinicianpaymentinfo cp \n        ON cp.clinicianid = c.id\n    LEFT JOIN commission_batch_payment_services cbps\n        ON cbps.serviceid = s.serviceid\n    WHERE\n        s.clinicianId = 2\n        AND s.serviceCategory = 'CLINICIAN_SPECIAL_BILLING'\n        AND s.status = 'active'\n        AND s.isAdjustment = 0\n        AND DATE(s.serviceAddedOn) >= '2025-01-01'\n        AND s.isRefunded=0\n        AND s.paymentstatus !='pending'\n        AND DATE(s.serviceAddedOn) <= '2025-12-13'\n        AND cbps.serviceid IS NULL AND chps.status IN ('pending', 'paid','waived')\n    GROUP BY \n        service_date,\n        c.id, \n        c.name,\n        c.phone,\n        c.occupation,\n        c.organization,\n        cp.commission\n    ORDER BY \n        service_date DESC\n","sqlMessage":"Unknown column 'chps.status' in 'where clause'","sqlState":"42S22","stack":"Error: Unknown column 'chps.status' in 'where clause'\n    at PromisePoolConnection.query (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\node_modules\\mysql2\\lib\\promise\\connection.js:29:22