{"code":"ER_BAD_FIELD_ERROR","errno":1054,"level":"error","message":"Database query error: Unknown column 'prev' in 'where clause'","sql":"SELECT \n\t\t\t\t\tp.patientid,\n\n\t\t\t\t\tCONCAT(\n\t\t\t\t\t\tp.fullpatientid, ' | ',\n\t\t\t\t\t\tp.firstname, ' ', p.lastname, ' | ',\n\t\t\t\t\t\tp.gender, ' | ',\n\t\t\t\t\t\tp.age, ' ', p.agetype\n\t\t\t\t\t) AS patient_details,\n\n\t\t\t\t\tb.billingid,\n\t\t\t\t\tb.billedon,\n\n\t\t\t\t\tCOUNT(ta.id) AS total_tests,\n\n\t\t\t\t\t-- 🔥 Test name + stage combined\n\t\t\t\t\tGROUP_CONCAT(\n\t\t\t\t\t\tDISTINCT CONCAT(\n\t\t\t\t\t\t\tCOALESCE(tp.name, CONCAT('Test-', ta.testid)),\n\t\t\t\t\t\t\t' (',\n\t\t\t\t\t\t\tCASE\n\t\t\t\t\t\t\t\tWHEN ta.resultEntryEnd IS NOT NULL THEN 'Completed'\n\t\t\t\t\t\t\t\tWHEN ta.processingEndDate IS NOT NULL THEN 'Processing Done'\n\t\t\t\t\t\t\t\tWHEN ta.collectionEndDate IS NOT NULL THEN 'Collected'\n\t\t\t\t\t\t\t\tELSE 'Pending'\n\t\t\t\t\t\t\tEND,\n\t\t\t\t\t\t\t')'\n\t\t\t\t\t\t)\n\t\t\t\t\t\tORDER BY tp.name\n\t\t\t\t\t\tSEPARATOR ', '\n\t\t\t\t\t) AS tests_with_stage\n\n\t\t\t\t\tFROM billing b\n\n\t\t\t\t\tJOIN new_patients p \n\t\t\t\t\tON p.patientid = b.patientid\n\n\t\t\t\t\tJOIN test_ascension ta \n\t\t\t\t\tON ta.billingid = b.billingid\n\n\t\t\t\t\tLEFT JOIN test_panels tp \n\t\t\t\t\tON tp.id = ta.testid\n\n\t\t\t\t\tWHERE b.billedon >= prev-19\n\t\t\t\t\tAND b.billedon <  prev-19 + INTERVAL 1 DAY\n\n\t\t\t\t\tGROUP BY \n\t\t\t\t\tb.billingid\n\n\t\t\t\t\tORDER BY \n\t\t\t\t\tb.billingid DESC;","sqlMessage":"Unknown column 'prev' in 'where clause'","sqlState":"42S22","stack":"Error: Unknown column 'prev' in 'where clause'\n    at PromisePoolConnection.query (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\node_modules\\mysql2\\lib\\promise\\connection.js:29:22)\n    at promisifyQuery (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\hooks\\helper.js:87:43)\n    at process.processTicksAndRejectio