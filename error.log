expenses, 0)) AS net_revenue,\n            s.outstanding_debt\n            FROM sales s\n            LEFT JOIN expenses e ON s.month = e.month\n            ORDER BY FIELD(s.month, 'January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December');\n    ","sqlMessage":"You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near '? AND ?\n        ) AS net_revenue\n        FROM dboservices\n        LEFT JOIN d...' at line 15","sqlState":"42000","stack":"Error: You have an error in your SQL syntax; check the manual that corresponds to your MariaDB server version for the right syntax to use near '? AND ?\n        ) AS net_revenue\n        FROM dboservices\n        LEFT JOIN d...' at line 15\n    at PromisePoolConnection.query (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\node_modules\\mysql2\\lib\\promise\\connection.js:29:22)\n    at promisifyQuery (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\hooks\\helper.js:87:43)\n    at process.processTicksAndRejections (node:internal/process/task_queues:105:5)\n    at async Object.monthlySalesTrend (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\controllers\\billing\\sales\\FinancialSummaryHandler.js:65:16)\n    at async handleFinancialAnalytics (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\controllers\\billing\\sales\\FinancialSummaryHandler.js:134:28)\n    at async C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\hooks\\helper.js:186:13"}
