ed'\n\t\t\t\t\t\t\t\tWHEN ta.processingEndDate IS NOT NULL THEN 'Processing Done'\n\t\t\t\t\t\t\t\tWHEN ta.collectionEndDate IS NOT NULL THEN 'Collected'\n\t\t\t\t\t\t\t\tWHEN ta.collectionStartDate IS NOT NULL THEN 'Collection Started'\n\t\t\t\t\t\t\t\tELSE 'Pending'\n\t\t\t\t\t\t\tEND AS current_stage\n\n\t\t\t\t\t\t\tFROM test_ascension ta\n\n\t\t\t\t\t\t\tLEFT JOIN test_panels tp \n\t\t\t\t\t\t\tON tp.id = ta.testid\n\n\t\t\t\t\t\t\tLEFT JOIN roles rr \n\t\t\t\t\t\t\tON rr.employeeid = ta.sampleCollectedBy\n\n\t\t\t\t\t\t\tLEFT JOIN roles vv\n\t\t\t\t\t\t\tON vv.employeeid = ta.sampleProcessedBy\n\n\t\t\t\t\t\t\tLEFT JOIN roles ee\n\t\t\t\t\t\t\tON ee.employeeid = ta.resultEnteredBy\n\n\t\t\t\t\t\t\tLEFT JOIN samplestatus ss\n\t\t\t\t\t\t\tON ss.ascensionid = ta.id\n\n\t\t\t\t\t\t\tLEFT JOIN dbotestresultapproval ra\n\t\t\t\t\t\t\tON ra.ascensionid = ta.id\n\n\n\t\t\t\t\t\t\tWHERE ta.billingid = 44\n\t\t\t\t\t\t\tAND (d.department IS NULL OR LOWER(d.department) <> 'ultrasound')\n\n\t\t\t\t\t\t\tORDER BY \n\t\t\t\t\t\t\tta.id ASC,\n\t\t\t\t\t\t\tss.keyid ASC,\n\t\t\t\t\t\t\tra.id ASC;\n\t\t","sqlMessage":"Unknown column 'd.department' in 'where clause'","sqlState":"42S22","stack":"Error: Unknown column 'd.department' in 'where clause'\n    at PromisePoolConnection.query (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\node_modules\\mysql2\\lib\\promise\\connection.js:29:22)\n    at promisifyQuery (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\hooks\\helper.js:89:43)\n    at process.processTicksAndRejections (node:internal/process/task_queues:105:5)\n    at async Operations.getAscensionOverViewModelTransaction (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server\\dist\\src\\models\\operations\\operations.js:309:16)\n    at async getAscensionOverViewModelTransactionHandler (C:\\Programming\\PLS-DIFFERENT-VERSIONS\\LobnosProfessionalVersion\\lobnos-server