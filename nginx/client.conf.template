# Nginx reverse-proxy config for a single PLS/Lobnos client deployment.
# The Node app terminates plain HTTP only (see src/app.ts); nginx handles TLS
# termination, security headers, rate limiting, compression, and static file
# serving in front of it.
#
# Placeholders (filled in by scripts/generate-nginx-config.ts):
#   __CLIENT_NAME__     e.g. acme (used for log file names and the rate-limit zone)
#   __CLIENT_DOMAIN__   e.g. acme.labresults.example.com
#   __UPSTREAM_PORT__   the app's PORT/PRODUCTION_PORT from that client's .env
#   __APP_ROOT__        absolute path to that client's distribution folder (cert/, public/uploads/)
#
# TLS certs default to the self-signed cert shipped in cert/. Replace
# ssl_certificate[_key] with certbot-issued paths (/etc/letsencrypt/live/<domain>/)
# for a publicly trusted certificate.
# ---- generated config below ----

# Login/auth brute-force protection. Zone name is namespaced per client since
# all client .conf files share the same nginx http{} context.
limit_req_zone $binary_remote_addr zone=__CLIENT_NAME___auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=__CLIENT_NAME___general:10m rate=30r/s;

# Reusable keepalive connection pool to the upstream Node process.
upstream __CLIENT_NAME___backend {
    server 127.0.0.1:__UPSTREAM_PORT__;
    keepalive 32;
}

server {
    listen 80;
    server_name __CLIENT_DOMAIN__;

    # ACME/certbot HTTP-01 challenge support
    location /.well-known/acme-challenge/ {
        root __APP_ROOT__/public;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __CLIENT_DOMAIN__;

    access_log __APP_ROOT__/logs/nginx-__CLIENT_NAME___access.log;
    error_log  __APP_ROOT__/logs/nginx-__CLIENT_NAME___error.log warn;

    ssl_certificate     __APP_ROOT__/cert/server.cert;
    ssl_certificate_key __APP_ROOT__/cert/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:__CLIENT_NAME___ssl:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security headers (patient/health data in transit and at the browser)
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    # Matches MAX_FILE_SIZE in .env (result/document/image uploads)
    client_max_body_size 50m;
    client_body_timeout 60s;
    client_header_timeout 60s;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_vary on;

    # Block access to dotfiles (.env, .git, etc.) and backup/source files anywhere under the app root
    location ~ /\. {
        deny all;
        return 404;
    }
    location ~* \.(sql|log|env|bak|old|swp)$ {
        deny all;
        return 404;
    }

    # Serve uploaded files directly instead of round-tripping through Node.
    # Uploads must never be executed as scripts.
    location /uploads/ {
        alias __APP_ROOT__/public/uploads/;
        expires 7d;
        access_log off;
        location ~* \.(php|php3|php4|php5|phtml|pl|py|jsp|asp|sh|cgi)$ {
            deny all;
        }
    }

    # Health check: quiet in logs, no rate limiting
    location = /api/v1/health {
        proxy_pass http://__CLIENT_NAME___backend;
        proxy_set_header Host $host;
        access_log off;
    }

    # Authentication endpoints get a stricter rate limit (brute-force protection)
    location ~ ^/api/v1/(prime/login|prime/forgotpassword|prime/resetpassword|authenticate) {
        limit_req zone=__CLIENT_NAME___auth burst=5 nodelay;
        proxy_pass http://__CLIENT_NAME___backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=__CLIENT_NAME___general burst=50 nodelay;

        proxy_pass http://__CLIENT_NAME___backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Kept for future WebSocket/real-time features
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 8 8k;
    }
}
