{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "ES2017",
      "DOM"
    ],
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
  },
  "include": [
    "src/**/*",
    "helpers/**/*",
    "public/**/*",
    "cert/**/*",
    "data/**/*",
    ".env"
  ],
  "exclude": [
    "node_modules",
    "dist",
  ]
}