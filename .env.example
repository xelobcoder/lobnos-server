# Prime Lab System (PLS) - Environment Configuration Template
# Copy to .env and update with your production values

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ============================================
# Database Configuration
# ============================================
# For single-tenant setup (default)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_strong_password_here
DB_NAME=primetenant1

# For multi-tenant setup, also configure:
# MULTI_TENANT=true
# TENANT_DB_PREFIX=primetenant

# ============================================
# Authentication & Security
# ============================================
# JWT secret for token signing - use a strong random value
JWT_SECRET=your_very_long_random_secret_key_at_least_32_characters_long
JWT_EXPIRY=7d

# ============================================
# Redis Cache (Optional but recommended)
# ============================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional read cache uses its own connection; disabled/offline means database-only.
REDIS_CACHE_ENABLED=true
REDIS_CACHE_TIMEOUT_MS=150
TEST_PANEL_CACHE_TTL_SECONDS=900
# Set a unique namespace per installation if sharing Redis across applications.
# All server instances for the same installation must use the same namespace.
# REDIS_CACHE_NAMESPACE=lobnos:my-lab:cache:v1

# ============================================
# Email Configuration
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password_or_app_token
EMAIL_FROM_NAME=Prime Lab System
EMAIL_FROM_ADDRESS=noreply@primelabsystem.com

# ============================================
# File Upload Configuration
# ============================================
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=50mb

# ============================================
# SSL/TLS Configuration
# ============================================
# If using HTTPS (recommended for production)
# HTTPS_ENABLED=true
# SSL_CERT_PATH=./cert/server.cert
# SSL_KEY_PATH=./cert/server.key

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_DIRECTORY=./backups
BACKUP_SCHEDULE=0 2 * * *  # Every day at 2 AM

# ============================================
# External Services
# ============================================
# Add any external API keys or service configurations here
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_NAME=twilio

# ============================================
# Feature Flags
# ============================================
# Enable/disable specific features
FEATURE_OUTSOURCING=true
FEATURE_PHARMACY=true
FEATURE_INSURANCE=true
FEATURE_COMMISSION=true
FEATURE_PAYROLL=true

# ============================================
# Compliance & Audit
# ============================================
AUDIT_LOGGING_ENABLED=true
DATA_RETENTION_DAYS=365
