# Prime Lab System (PLS) - Environment Configuration Template
# Copy to .env and update with your production values

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# ============================================
# Database Configuration
# ============================================
# For single-tenant setup (default)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_strong_password_here
DB_NAME=primetenant1

# For multi-tenant setup, also configure:
# MULTI_TENANT=true
# TENANT_DB_PREFIX=primetenant

# Per-process budget for tenant pools (control/single-tenant pools are separate).
TENANT_DB_CONNECTION_BUDGET=100
TENANT_DB_CACHE_MAX_ENTRIES=100
TENANT_DB_MYSQL_POOL_MAX=5
TENANT_DB_KNEX_POOL_MAX=5
TENANT_DB_IDLE_TIMEOUT_MS=300000

# ============================================
# Master Control Database (primelabmaster_control)
# ============================================
# Holds the tenant registry, the global login directory and the master test catalog.
# Created by `npm run master:merge` from pls_master_platform + system_configuration.
SYSTEM_CONFIG_DB_HOST=localhost
SYSTEM_CONFIG_DB_PORT=3306
SYSTEM_CONFIG_DB_USERNAME=root
SYSTEM_CONFIG_DB_PASSWORD=your_strong_password_here
SYSTEM_CONFIG_DATABASE=primelabmaster_control

# ============================================
# Authentication & Security
# ============================================
# JWT secret for token signing - use a strong random value
JWT_SECRET=your_very_long_random_secret_key_at_least_32_characters_long
JWT_EXPIRY=7d

# ============================================
# Redis Cache (Optional but recommended)
# ============================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional read cache uses its own connection; disabled/offline means database-only.
REDIS_CACHE_ENABLED=false
REDIS_CACHE_TIMEOUT_MS=150
TEST_PANEL_CACHE_TTL_SECONDS=900
# Branches, departments, and company information (30 minutes).
REFERENCE_DATA_CACHE_TTL_SECONDS=1800
# Set a unique namespace per installation if sharing Redis across applications.
# All server instances for the same installation must use the same namespace.
# REDIS_CACHE_NAMESPACE=lobnos:my-lab:cache:v1

# ============================================
# Email Configuration
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password_or_app_token
EMAIL_FROM_NAME=Prime Lab System
EMAIL_FROM_ADDRESS=noreply@primelabsystem.com

# ============================================
# File Upload Configuration
# ============================================
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=50mb

# ============================================
# SSL/TLS Configuration
# ============================================
# If using HTTPS (recommended for production)
# HTTPS_ENABLED=true
# SSL_CERT_PATH=./cert/server.cert
# SSL_KEY_PATH=./cert/server.key

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_DIRECTORY=./backups
BACKUP_SCHEDULE=0 2 * * *  # Every day at 2 AM

# ============================================
# External Services
# ============================================
# Add any external API keys or service configurations here
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_NAME=twilio

# ============================================
# Feature Flags
# ============================================
# Enable/disable specific features
FEATURE_OUTSOURCING=true
FEATURE_PHARMACY=true
FEATURE_INSURANCE=true
FEATURE_COMMISSION=true
FEATURE_PAYROLL=true

# ============================================
# Compliance & Audit
# ============================================
AUDIT_LOGGING_ENABLED=true
DATA_RETENTION_DAYS=365
# Redis is optional; the application uses the database when Redis is unavailable.
# Set REDIS_CACHE_ENABLED=false to disable cache connection attempts entirely.
REDIS_CACHE_ENABLED=true
# Optional bind address. Web deployments keep the default 0.0.0.0; the
# Electron desktop runtime sets this to 127.0.0.1.
HOST=0.0.0.0

# Explicit public profiles can alternatively be managed by the platform super-admin.
PUBLIC_FACILITY_DIRECTORY_JSON=[]
# Same-machine development only; remote facility portals must use HTTPS.
PUBLIC_FACILITY_ALLOW_LOOPBACK_HTTP=false

# Offline signed licensing: opt in explicitly. Unset/legacy preserves existing deployments.
# The existing prime_window_access validity/grace window remains authoritative in BOTH modes.
PLS_LICENSE_MODE=legacy
# Required in signed mode: absolute directory OUTSIDE the checkout/distribution.
# Desktop sets this to app.getPath('userData')/licensing; server/CLI/workers must share it.
# PLS_LICENSE_STORAGE_DIR=C:\ProgramData\PrimeLabSystem\licensing
# Exactly ONE issuer PUBLIC verification key source; Ed25519 SPKI PEM only, never a private key.
# Dotenv expands \n inside double quotes into actual PEM newlines.
# PLS_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<issuer-public-key-base64>\n-----END PUBLIC KEY-----\n"
# PLS_LICENSE_PUBLIC_KEY_FILE=C:\ProgramData\PrimeLabSystem\issuer-public.pem
# Desktop selector only: supplies CLI --tenant-id; does not override server tenant routing.
# PLS_LICENSE_TENANT_ID=3
# No HTTP recovery-secret setting: activation requires authenticated administrator or local CLI.
# See docs/offline-licensing.md for activation, renewal, permissions, exemptions and limitations.
