<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Authentication of email </title>
  <style>
    /* Style for the navbar */
    .navbar {
      background-color: #333;
      color: white;
      font-size: 20px;
      padding: 25px;
      text-align: center;
    }

    /* Styles for the loading spinner */
    #loading {
      display: none;
      position: fixed;
      z-index: 9999;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 40px;
    }
/* Spinner styles */
.spinner {
  width: 40px;
  height: 40px;
  border: 4px solid rgba(0, 0, 0, 0.1);
  border-left-color: #7983ff; /* Change this color to your preference */
  border-radius: 50%;
  animation: spin 1s linear infinite; /* Animation */
}

#content {
  display: flex;
  justify-content: center;
  background-color: slateblue;
  border-radius: 5px;
  padding: 20px;
  margin: 20px;
  color: white;
  border: 1px solid slategray;
  font-size: 20px;
}

/* Keyframe animation */
@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* screen less than 400px */
@media  screen and (max-width: 400px) {
  #content {
    font-size: 15px;
  }
}

    /* Body styles */
    body {
      margin: 0;
      font-family: proxima-nova, sans-serif;
    }
  </style>
</head>
<body>
  <!-- Navbar -->
  <div class="navbar">
    Prime Lab Systems
  </div>

  <!-- Content -->
  <div id="content">
    <!-- Your page content goes here -->
  </div>

  <!-- Loading Animation -->
  <div id="loading">
    <!-- Large spinner for loading -->
    <div class="spinner"></div>
    Authenticating credentials
  </div>

  <script>
    // JavaScript for the loading state
    function showLoading() {
      document.getElementById('loading').style.display = 'block';
      // Simulate a delay (you can adjust the timeout duration as needed)
    }

    function hideLoading() {
      document.getElementById('loading').style.display = 'none';
    }


    // Call showLoading function to display loading state (you can call this as needed)
    showLoading();


    // get content tag

    const content = document.getElementById('content');

    const token = window.location.href.split('?')[1].slice(6);

      if (token) {
        
        fetch(`http://localhost:5000/api/v1/verify/email/token?token=${token}`)
        .then ( (response) => {return response.json()})
        .then ( (response) => {
          const {status,statusCode,message} = response;

          if (statusCode === 200 && status == 'success') {
            hideLoading();
            content.innerHTML = `${message}`;
          } else {
            hideLoading();
            content.innerHTML = `Link is invalid or expired. A new Link will be sent to your email to verify your email.`;
          }
        })
        .catch ( (err) => {
          hideLoading();
          content.innerHTML = `Something went wrong. Please try again.`;
        })
      }

  </script>
</body>
</html>
