{
  "workbench.editor.pinnedTabSizing": "normal",
  "editor.tabSize": 3,
  "editor.fontFamily": "Menlo,Monaco,'Courier',monospace",
  "editor.tabCompletion": "on",
  "editor.wordWrap": "on",
  "editor.wordWrapColumn": 140,
  "editor.formatOnSave": true,
  "editor.fontSize": 15,
  "editor.bracketPairColorization.enabled": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "sqltools.connections": [
    {
      "mysqlOptions": {
        "authProtocol": "default",
        "enableSsl": "Disabled"
      },
      "previewLimit": 50,
      "server": "localhost",
      "port": 3306,
      "driver": "MySQL",
      "name": "xconnect",
      "database": "limsdb",
      "username": "root",
      "password": ""
    }
  ],
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}