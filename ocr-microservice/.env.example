# OCR Microservice Environment Configuration

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=2

# File Storage Settings
UPLOAD_DIR=./uploads
PROCESSED_DIR=./processed
RESULTS_DIR=./results
DEBUG_DIR=./debug
LOGS_DIR=./logs

# File Size Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes

# OCR Settings
OCR_TIMEOUT=30  # seconds
PADDLE_CONFIDENCE_THRESHOLD=0.7
TESSERACT_CONFIDENCE_THRESHOLD=0.6

# Image Processing Settings
IMAGE_MAX_WIDTH=2000
IMAGE_MAX_HEIGHT=2000
IMAGE_QUALITY=95

# Template Settings
TEMPLATE_CONFIG_DIR=./config/templates

# Validation Settings
VALIDATION_STRICT_MODE=true
CONFIDENCE_WARNING_THRESHOLD=0.8
CONFIDENCE_CRITICAL_THRESHOLD=0.6

# Performance Settings
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=60

# Security Settings
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5000"]
CORS_ALLOW_CREDENTIALS=true